{
  "name": "temporalthread-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Give AI agents a persistent sense of time.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "audit": "pnpm audit --prod --audit-level high",
    "build": "tsc -b",
    "certify:codex:check": "node scripts/check-live-codex-certification.mjs",
    "certify:codex:cleanup": "node scripts/cleanup-live-codex-certification.mjs",
    "certify:codex:prepare": "node scripts/prepare-live-codex-certification.mjs",
    "clean": "tsc -b --clean",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "verify:codex-package": "node scripts/verify-codex-package.mjs",
    "verify:host-neutral-mcp": "node scripts/verify-host-neutral-mcp.mjs",
    "verify:sqlite-recovery": "node scripts/verify-sqlite-recovery.mjs",
    "release:artifacts": "node scripts/build-release-artifacts.mjs",
    "release:sbom": "node scripts/generate-release-sbom.mjs",
    "verify:release-artifacts": "node scripts/verify-release-artifacts.mjs",
    "verify:clean-source": "node scripts/verify-clean-source-install.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@opencode-ai/plugin": "1.1.33",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.3",
    "better-sqlite3": "12.11.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
