{
  "name": "@sudarshanchaudhari/temporalthread-temporal-parser",
  "version": "0.1.0",
  "description": "Deterministic relative-time parsing for TemporalThread.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/SUDARSHANCHAUDHARI/TemporalThread#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SUDARSHANCHAUDHARI/TemporalThread.git",
    "directory": "packages/temporal-parser"
  },
  "bugs": {
    "url": "https://github.com/SUDARSHANCHAUDHARI/TemporalThread/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@sudarshanchaudhari/temporalthread-shared-types": "workspace:*"
  }
}
