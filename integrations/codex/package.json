{
  "name": "@sudarshanchaudhari/temporalthread-codex-integration",
  "version": "0.1.0",
  "description": "Official Codex integration package for TemporalThread.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/SUDARSHANCHAUDHARI/TemporalThread#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SUDARSHANCHAUDHARI/TemporalThread.git",
    "directory": "integrations/codex"
  },
  "bugs": {
    "url": "https://github.com/SUDARSHANCHAUDHARI/TemporalThread/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "hooks.json",
    "plugin",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@sudarshanchaudhari/temporalthread-config": "workspace:*",
    "@sudarshanchaudhari/temporalthread-core": "workspace:*",
    "@sudarshanchaudhari/temporalthread-shared-types": "workspace:*",
    "smol-toml": "1.7.0",
    "zod": "4.4.3"
  }
}
