    "dist/**/*.js.map"
  ],
  "dependencies": {
    "@temporalthread/config": "workspace:*",
    "@temporalthread/core": "workspace:*",
    "@temporalthread/shared-types": "workspace:*",
    "zod": "4.4.3"
  }
}
