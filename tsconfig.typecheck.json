{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@sudarshanchaudhari/temporalthread-shared-types": ["./packages/shared-types/src/index.ts"],
      "@sudarshanchaudhari/temporalthread-config": ["./packages/config/src/index.ts"],
      "@sudarshanchaudhari/temporalthread-temporal-parser": ["./packages/temporal-parser/src/index.ts"],
      "@sudarshanchaudhari/temporalthread-storage-sqlite": ["./packages/storage-sqlite/src/index.ts"],
      "@sudarshanchaudhari/temporalthread-core": ["./packages/core/src/index.ts"],
      "@sudarshanchaudhari/temporalthread-codex-integration": ["./integrations/codex/src/index.ts"],
      "@sudarshanchaudhari/temporalthread-mcp-server": ["./apps/mcp-server/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "integrations/**/*.ts",
    "examples/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
